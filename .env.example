DATABASE_URL=postgresql://usuario:password@host:6543/postgres
JWT_SECRET=

# Subida de imágenes de producto (bucket "Imagenes", publico de lectura).
# La service_role key nunca debe ir en el cliente/app — solo aquí.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Automatizaciones de IA via n8n. WEBHOOK_SECRET viaja en el header
# X-Webhook-Secret en los DOS sentidos: se manda al llamar a cada webhook
# (CityAPI -> n8n) y se exige en /catalogo-externo, /contacto-externo y
# /reparacion-externa (n8n -> CityAPI).
WEBHOOK_SECRET=
# Solo durante un cambio de secreto: el valor VIEJO, para que el servidor acepte
# ambos mientras n8n se actualiza. Se borra al terminar el cambio.
WEBHOOK_SECRET_ANTERIOR=
N8N_WEBHOOK_INVENTARIO_IA=
N8N_WEBHOOK_CM_GENERAR=
N8N_WEBHOOK_CM_GENERAR_RECURSO=
N8N_WEBHOOK_CM_PUBLICAR=
N8N_WEBHOOK_MEJORAR_IMAGEN=
N8N_WEBHOOK_NOTIFICAR_CLIENTE=
